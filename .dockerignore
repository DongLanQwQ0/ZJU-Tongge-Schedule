# ---------------------------------------------------------------- 构建上下文
#
# 原则：只把「跑起来需要的东西」送进构建上下文。
# 这个仓库根目录有真实课表（含同学真名），绝不能进镜像。

# 真实课表 —— 与 .gitignore 同样的理由，这里是第二道闸
*.ics

# 开发与版本控制
.git
.gitignore
.gitattributes
test/
docs/
node_modules/

# 密钥：本机开发那把（.tongge/key.env）与任何随手放的 .env。
# 镜像里 NODE_ENV=production，服务本来就不会去读它们 —— 这里是第二道闸：
# 构建上下文不该带着钥匙走来走去。
.tongge/
.env
.env.*

# 编辑器与系统
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# 日志与临时文件
*.log
*.tmp
*.corrupt-*

# 打包产物本身

.dockerignore
docker-compose.yml
docker-compose.*.yml

# ⚠️ 数据（账号、会话、群组）**绝不能**进镜像。
#    镜像会被推到 registry、被复制、被留档；一旦带上 data/，等于把密码哈希和
#    会话令牌一起发出去 —— 而会话令牌就是 Bearer 凭据，拿到即可冒充登录。
#    首次部署改成显式导入：
#      docker run --rm -v tongge-data:/data -v "$PWD/data:/seed" alpine \
#        sh -c 'cp -R /seed/. /data/'
data/
