{
  "name": "tongge",
  "version": "1.0.0",
  "private": true,
  "description": "同格 · 找个课搭子一起上课 —— 零依赖 Node 服务 + 纯前端，浏览器本地解析课表",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "docker:build": "docker build -t tongge:1.0 .",
    "docker:build:clean": "docker build -t tongge:1.0 --build-arg INCLUDE_SESSIONS=false .",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f tongge",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18"
  }
}
